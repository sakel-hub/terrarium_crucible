# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.lua text eol=lf
*.txt text eol=lf
*.tr text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.po text eol=lf
*.pot text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 3D models and authoring assets
*.blend binary
*.ai binary
*.xcf binary
*.psd binary
*.kra binary
*.aseprite binary
*.b3d binary
*.glb binary
*.gltf text eol=lf
*.obj text eol=lf

# Textures and media
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary

# ==============================================================================
# GitHub Linguist Overrides (Keeps Repository Statistics 100% Lua)
# ==============================================================================
*.py linguist-generated=true
scripts/** linguist-generated=true
assets/** linguist-generated=true
mods/*/assets/** linguist-generated=true
scratch/** linguist-generated=true
package-lock.json linguist-generated=true

# ==============================================================================
# Git Archive / Release Exclusions (ContentDB & GitHub Releases)
# Excludes test suites, authoring assets, AI configs, dev scripts, and OS files
# from distributed release archives (git archive).
# ==============================================================================

# Operating System metadata
.DS_Store export-ignore
**/.DS_Store export-ignore
Thumbs.db export-ignore
desktop.ini export-ignore

# Python tooling, cache, and generated scripts
*.py export-ignore
__pycache__ export-ignore
*.py[cod] export-ignore

# Git, CI/CD, AI assistants, and developer configuration
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/.luacheckrc export-ignore
/.luarc.json export-ignore
/.cdb.json export-ignore
/JAM2026.md export-ignore
/.github export-ignore
/.agents export-ignore
/.agents/** export-ignore
/.gemini export-ignore
/.gemini/** export-ignore
/.cursor export-ignore
/.cursor/** export-ignore
/.claude export-ignore
/.claude/** export-ignore
/.codex export-ignore
/.codex/** export-ignore
/.copilot export-ignore
/.copilot/** export-ignore
/.windsurf export-ignore
/.windsurf/** export-ignore
/.roo export-ignore
/.roo/** export-ignore
.aider* export-ignore
/.cursorrules export-ignore
/.clinerules export-ignore
/.windsurfrules export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/GEMINI.md export-ignore

# Node.js, npm, and environment files
/package.json export-ignore
/package-lock.json export-ignore
/.npmrc export-ignore
/.nvmrc export-ignore
/.env* export-ignore
/node_modules export-ignore

# Test suites, benchmarks, and bundled dev-only files
/test*.lua export-ignore
/tests export-ignore
tests/** export-ignore
mods/*/test*.lua export-ignore
mods/*/.luacheckrc export-ignore
mods/*/bower.json export-ignore
mods/*/.mailmap export-ignore

# Source assets, authoring scenes, unused prototypes, and conversion scripts
/assets export-ignore
assets/** export-ignore
mods/*/assets export-ignore
mods/*/assets/** export-ignore
/scripts export-ignore
scripts/** export-ignore
/scratch export-ignore
scratch/** export-ignore
*.blend export-ignore
*.blend1 export-ignore
*.xcf export-ignore
*.psd export-ignore
*.kra export-ignore
*.aseprite export-ignore
*.ai export-ignore
*.zip export-ignore
mods/tc_assets/textures/tc_hud_accent.png export-ignore
mods/tc_assets/textures/tc_hud_bg.png export-ignore

