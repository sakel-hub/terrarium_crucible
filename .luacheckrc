std = "lua51"
exclude_files = {
    "node_modules/**",
    "scripts/**",
    "mods/game_commands/**",
    "mods/hudbars/**",
    "mods/x_player_api/**",
    "mods/player_monoids/**",
    "mods/sfinv/**",
    "mods/show_wielded_item/**",
}
