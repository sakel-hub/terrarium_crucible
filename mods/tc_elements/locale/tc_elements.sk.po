#: api.lua:65
msgid "Scorching Brimstone"
msgstr "Žeravá síra"

#: api.lua:66
msgid "Scorching Brimstone (Hot Block — Splash Water [3])"
msgstr "Žeravá síra (Horúci blok — Ošpliechajte vodou [3])"

#: api.lua:67
msgid "Brimstone"
msgstr "Síra"

#: api.lua:68 api.lua:128
msgid "Flask [3]"
msgstr "Fľaša [3]"

#: api.lua:74
msgid "A glowing-hot lava stone dropped in from above by the wizard."
msgstr "Rozžeravený lávový kameň zhodený zhora čarodejníkom."

#: api.lua:75
msgid "Raises heat, burns your boots (2 HP/s) if stood on, bonks on impact, & scorches green soil."
msgstr "Zvyšuje teplo, páli čižmy (2 HP/s) pri stúpení, udrie pri dopade a spáli zelenú pôdu."

#: api.lua:76
msgid "Splash with Flask [3], siphon with low Bellows [2] to refill all Puffs, or pair with Ice via Trowel [1]!"
msgstr "Ošpliechajte Fľašou [3], odsajte takmer prázdnymi Mechmi [2] na plné doplnenie alebo spojte s Ľadom Lopatkou [1]!"

#: api.lua:78
msgid "Splash with Flask [3] · Siphon with low Bellows [2] · Pair with Ice [1]"
msgstr "Ošpliechať Fľašou [3] · Odsať Mechmi [2] · Spojiť s Ľadom [1]"

#: api.lua:81
msgid "Dropping Scorching Brimstone! Splash it with Water Flask [3] or hit it mid-air for bonus growth!"
msgstr "Padá Žeravá síra! Ošpliechajte ju Fľašou s vodou [3] alebo ju zasiahnite vo vzduchu pre bonusový rast!"

#: api.lua:86
msgid "Glacial Ice Shard"
msgstr "Ľadovcový črep"

#: api.lua:87
msgid "Glacial Ice Shard (Cold Block — Melt with Bellows [2])"
msgstr "Ľadovcový črep (Studený blok — Roztopte Mechmi [2])"

#: api.lua:88
msgid "Ice"
msgstr "Ľad"

#: api.lua:89
msgid "Bellows [2]"
msgstr "Mechy [2]"

#: api.lua:93
msgid "A freezing blue ice crystal that cools down the glass room."
msgstr "Mrazivý modrý ľadový kryštál, ktorý ochladzuje sklenenú miestnosť."

#: api.lua:94
msgid "Makes the room colder, makes the floor slippery, and chills nearby green soil."
msgstr "Ochladzuje miestnosť, robí podlahu šmykľavou a mrazí okolitú zelenú pôdu."

#: api.lua:95
msgid "Left-Click with Thermal Bellows [2] to melt into fresh Water (then refill your Water Flask [3]!)."
msgstr "Ľavým klikom s Tepelnými mechmi [2] ho roztopte na čistú Vodu (a potom si ňou doplňte Fľašu s vodou [3]!)."

#: api.lua:96
msgid "Left-Click with Bellows [2] to melt, then scoop Water with Flask [3]"
msgstr "Ľavý klik Mechmi [2] na roztopenie, potom naberte Vodu Fľašou [3]"

#: api.lua:99
msgid "Dropping a Glacial Ice Shard! Melt it with Bellows [2] (or catch it mid-air for bonus growth)!"
msgstr "Padá Ľadovcový črep! Roztopte ho Mechmi [2] (alebo ho zachyťte vo vzduchu pre bonusový rast)!"

#: api.lua:104
msgid "Vitriol Acid Slime"
msgstr "Kyslý vitriolový sliz"

#: api.lua:105
msgid "Vitriol Acid Slime (Sour Puddle — Clear with Pestle [4])"
msgstr "Kyslý vitriolový sliz (Kyslá mláka — Vyčistite Tĺčikom [4])"

#: api.lua:106
msgid "Acid"
msgstr "Kyselina"

#: api.lua:107
msgid "Pestle [4]"
msgstr "Tĺčik [4]"

#: api.lua:113
msgid "A bubbling green puddle that sours the soil and sticks to your boots."
msgstr "Bublajúca zelená mláka, ktorá okysľuje pôdu a lepí sa na čižmy."

#: api.lua:114
msgid "Sours soil, slows & stings your feet (2 HP/s), stops jumping inside it, & spoils green soil."
msgstr "Okysľuje pôdu, spomaľuje a štípe nohy (2 HP/s), bráni skákaniu v nej a kazí zelenú pôdu."

#: api.lua:115
msgid "Left-Click on or near it with Limestone Pestle [4] (or place Chalk beside it) to turn the floor into fast green Fertile Soil!"
msgstr "Ľavým klikom na ňu či vedľa nej Vápencovým tĺčikom [4] (alebo položením Kriedy vedľa) premeníte zem na zelenú Úrodnú pôdu!"

#: api.lua:117
msgid "Left-Click with Pestle [4] · Place Chalk beside it for green Speed Soil"
msgstr "Ľavý klik Tĺčikom [4] · Položte vedľa Kriedu pre zelenú Rýchlu pôdu"

#: api.lua:120
msgid "Pouring green Acid Slime! Dust it with Pestle [4] to turn the floor into green Speed Soil!"
msgstr "Leje sa zelený Kyslý sliz! Poprášte ho Tĺčikom [4] a premeňte podlahu na zelenú Rýchlu pôdu!"

#: api.lua:125
msgid "Alkaline Chalk"
msgstr "Zásaditá krieda"

#: api.lua:126
msgid "Alkaline Chalk (Dry Block — Splash Water [3])"
msgstr "Zásaditá krieda (Suchý blok — Ošpliechajte vodou [3])"

#: api.lua:127
msgid "Chalk"
msgstr "Krieda"

#: api.lua:132
msgid "A dry, chalky crystal block that throws off soil balance."
msgstr "Suchý kriedový kryštálový blok, ktorý narúša rovnováhu pôdy."

#: api.lua:133
msgid "Makes soil too chalky (alkaline); melts away on its own if flowing water touches it."
msgstr "Robí pôdu príliš zásaditou (kriedovou); sama sa rozpustí, ak sa jej dotkne tečúca voda."

#: api.lua:134
msgid "Wash with Flask [3], grind with low Pestle [4] to refill all Sweeps, or pair with Acid via Trowel [1]!"
msgstr "Zmyte Fľašou [3], rozdrvte takmer prázdnym Tĺčikom [4] na plné doplnenie alebo spojte s Kyselinou Lopatkou [1]!"

#: api.lua:136
msgid "Wash with Flask [3] · Grind with low Pestle [4] · Pair with Acid [1]"
msgstr "Zmyť Fľašou [3] · Rozdrviť Tĺčikom [4] · Spojiť s Kyselinou [1]"

#: api.lua:139
msgid "Dropping Alkaline Chalk! Splash it with Water Flask [3] or pair it beside green Acid Slime!"
msgstr "Padá Zásaditá krieda! Ošpliechajte ju Fľašou s vodou [3] alebo ju spojte so zeleným Kyslým slizom!"

#: api.lua:152
msgid "Prismatic Geode"
msgstr "Prizmatická geóda"

#: api.lua:153
msgid "Prismatic Geode (Bonus Crystal — Hit with Trowel [1]!)"
msgstr "Prizmatická geóda (Bonusový kryštál — Udrite Lopatkou [1]!)"

#: api.lua:154
msgid "Geode"
msgstr "Geóda"

#: api.lua:155
msgid "Trowel [1]"
msgstr "Lopatka [1]"

#: api.lua:161
msgid "A shimmering rainbow crystal that drops in starting from Level 2."
msgstr "Trblietavý dúhový kryštál, ktorý začína padať od 2. úrovne."

#: api.lua:162
msgid "Clears nearby hazards, makes Speed Soil, refills all Tools [2–4], & rewards +1 Aegis Potion!"
msgstr "Vyčistí okolité hrozby, vytvorí Rýchlu pôdu, doplní nástroje [2–4] a pridá +1 Elixír Egidy!"

#: api.lua:163
msgid "Left-Click or Right-Click it with your Trowel [1] (or set any block beside it) before time runs out!"
msgstr "Kliknite na ňu ľavým alebo pravým tlačidlom Lopatkou [1] (alebo položte vedľa ľubovoľný blok), kým nevyprší čas!"

#: api.lua:164
msgid "A shimmering Prismatic Geode is falling! Hit it with Trowel [1] within 22s for +1 Aegis Potion, green Speed Soil, & bonus Bloom!"
msgstr "Padá trblietavá Prizmatická geóda! Udrite ju Lopatkou [1] do 22s pre +1 Elixír Egidy, zelenú Rýchlu pôdu a bonusový Rozkvet!"

#: api.lua:172
msgid "Crucible Seedling (Stage 1/4)"
msgstr "Sadenica téglika (Fáza 1/4)"

#: api.lua:180
msgid "Crucible Vines (Stage 2/4)"
msgstr "Šľahúne téglika (Fáza 2/4)"

#: api.lua:188
msgid "Crucible Astral Rose (Stage 3/4)"
msgstr "Astrálna ruža téglika (Fáza 3/4)"

#: api.lua:196
msgid "Philosopher's Lotus (Stage 4/4 · Full Bloom)"
msgstr "Lotos mudrcov (Fáza 4/4 · Plný rozkvet)"

#: api.lua:226 init.lua:168 init.lua:184
msgid "Fertile Soil"
msgstr "Úrodná pôda"

#: api.lua:227 init.lua:185
msgid "Faster Plant Growth · Faster Running"
msgstr "Rýchlejší rast rastlín · Rýchlejší beh"

#: api.lua:228 init.lua:186
msgid "Walk on this glowing green soil to run much faster!"
msgstr "Kráčajte po tejto žiariacej zelenej pôde, aby ste bežali oveľa rýchlejšie!"

#: api.lua:304
msgid "Tools [2–4] Refilled"
msgstr "Nástroje [2–4] doplnené"

#: api.lua:309
msgid "Tools [2–4] Refilled · +1 Aegis!"
msgstr "Nástroje [2–4] doplnené · +1 Egida!"

#: api.lua:312
msgid "Tools [2–4] Refilled · Belt Full Bonus!"
msgstr "Nástroje [2–4] doplnené · Bonus za plný opasok!"

#: api.lua:319
msgid "✦ Geode Cracked! (+@1% Bloom)"
msgstr "✦ Geóda rozbitá! (+@1% Rozkvet)"

#: entities.lua:7
msgid "Catch mid-air with filled Flask [3] (or low Bellows [2] to refill)!"
msgstr "Zachyťte vo vzduchu plnou Fľašou [3] (alebo Mechmi [2] na doplnenie)!"

#: entities.lua:8
msgid "Catch mid-air with charged Bellows [2] for bonus Bloom!"
msgstr "Zachyťte vo vzduchu nabitými Mechmi [2] pre bonusový Rozkvet!"

#: entities.lua:9
msgid "Catch mid-air with charged Pestle [4] for bonus Bloom!"
msgstr "Zachyťte vo vzduchu nabitým Tĺčikom [4] pre bonusový Rozkvet!"

#: entities.lua:10
msgid "Catch mid-air with filled Flask [3] (or low Pestle [4] to refill)!"
msgstr "Zachyťte vo vzduchu plnou Fľašou [3] (alebo Tĺčikom [4] na doplnenie)!"

#: entities.lua:11
msgid "Click with Trowel [1] (or let it land) to crack open the crystal!"
msgstr "Kliknite Lopatkou [1] (alebo nechajte dopadnúť) a rozbite kryštál!"

#: entities.lua:88
msgid "Falling Block"
msgstr "Padajúci blok"

#: entities.lua:89
msgid "Hit mid-air with the matching tool!"
msgstr "Zasiahnite vo vzduchu zodpovedajúcim nástrojom!"

#: entities.lua:93
msgid "Falling @1"
msgstr "Padá: @1"

#: entities.lua:93
msgid "Dropping from above"
msgstr "Padá zhora"

#: entities.lua:156
msgid "Flask empty! Click Water/Steam to fill, or click air to condense +1."
msgstr "Fľaša je prázdna! Kliknite na Vodu/Paru na naplnenie alebo do vzduchu pre +1."

#: entities.lua:169
msgid "Mid-Air Siphon → Bellows Full!"
msgstr "Odsatie vo vzduchu → Mechy sú plné!"

#: entities.lua:176
msgid "Bellows [2] is full! Splash Brimstone [3] or pair Ice [1]."
msgstr "Mechy [2] sú plné! Ošpliechajte Síru [3] alebo spojte s Ľadom [1]."

#: entities.lua:190
msgid "Mid-Air Grind → Pestle Full!"
msgstr "Rozdrvenie vo vzduchu → Tĺčik je plný!"

#: entities.lua:197
msgid "Pestle [4] is full! Wash Chalk [3] or pair Acid [1]."
msgstr "Tĺčik [4] je plný! Zmyte Kriedu [3] alebo spojte s Kyselinou [1]."

#: entities.lua:219
msgid "Bellows empty! Click Brimstone to refill, or click air to pump +1."
msgstr "Mechy sú prázdne! Kliknite na Síru na doplnenie alebo do vzduchu pre +1."

#: entities.lua:235
msgid "Pestle empty! Click Chalk to refill, or click air to scrape +1."
msgstr "Tĺčik je prázdny! Kliknite na Kriedu na doplnenie alebo do vzduchu pre +1."

#: entities.lua:251
msgid "★ Aerial Catch!"
msgstr "★ Vzdušný zásah!"

#: entities.lua:251
msgid "★ Mid-Air Catch!"
msgstr "★ Zachytenie vo vzduchu!"

#: entities.lua:265
msgid "Use the matching tool!"
msgstr "Použite zodpovedajúci nástroj!"

#: entities.lua:345
msgid "Ouch! Step outside glowing floor rings before falling blocks land (or swat them mid-air)!"
msgstr "Au! Ustúpte zo žiariacich kruhov na podlahe skôr, než bloky dopadnú (alebo ich zasiahnite vo vzduchu)!"

#: init.lua:21 init.lua:28
msgid "Terrarium Glass Wall"
msgstr "Sklenená stena terária"

#: init.lua:22 init.lua:45
msgid "Glass Room Wall"
msgstr "Stena sklenenej miestnosti"

#: init.lua:23
msgid "Thick brass-framed glass walls surrounding your tiny garden."
msgstr "Hrubé sklenené steny v mosadznom ráme obklopujúce vašu malú záhradu."

#: init.lua:24
msgid "Keeps everything safely inside and opens outward when you finish a level!"
msgstr "Udržujú všetko bezpečne vnútri a otvoria sa navonok po dokončení úrovne!"

#: init.lua:25
msgid "Peer through the glass to see the wizard's giant wooden desk, candles, and open spellbook."
msgstr "Nazrite cez sklo a uvidíte obrovský drevený stôl čarodejníka, sviečky a otvorenú knihu kúziel."

#: init.lua:44 init.lua:50
msgid "Brass Terrarium Rim"
msgstr "Mosadzná obruba terária"

#: init.lua:46
msgid "Carved brass trim along the open top of the glass walls."
msgstr "Tvarované mosadzné lemovanie pozdĺž otvoreného vrchu sklenených stien."

#: init.lua:47
msgid "Frames the open ceiling where the wizard drops blocks in from above."
msgstr "Lemuje otvorený strop, kadiaľ čarodejník zhadzuje bloky zhora."

#: init.lua:61 init.lua:66
msgid "Wizard's Wooden Desk"
msgstr "Čarodejníkov drevený stôl"

#: init.lua:62 init.lua:78 init.lua:95 init.lua:112
msgid "Outside Scenery"
msgstr "Vonkajšia scenéria"

#: init.lua:63
msgid "Giant polished wooden desk planks underneath the glass terrarium."
msgstr "Obrovské leštené drevené dosky stola pod skleneným teráriom."

#: init.lua:77 init.lua:82
msgid "Wizard's Open Spellbook"
msgstr "Čarodejníkova otvorená kniha kúziel"

#: init.lua:79
msgid "Giant glowing spellbook pages lying open on the desk outside the glass."
msgstr "Obrovské žiariace stránky knihy kúziel otvorené na stole za sklom."

#: init.lua:94 init.lua:99
msgid "Giant Beeswax Candle"
msgstr "Obrovská vosková sviečka"

#: init.lua:96
msgid "A towering beeswax candle warming the wizard's desk outside the glass."
msgstr "Vysoká sviečka zo včelieho vosku hrejúca čarodejníkov stôl za sklom."

#: init.lua:111 init.lua:117
msgid "Dancing Candle Flame"
msgstr "Tancujúci plameň sviečky"

#: init.lua:113
msgid "A warm flickering flame shining atop the giant desk candles."
msgstr "Teplý mihotavý plameň žiariaci na vrchole obrovských stolových sviečok."

#: init.lua:114
msgid "Lights up the workshop with a cozy golden glow."
msgstr "Osvetľuje dielňu útulnou zlatistou žiarou."

#: init.lua:133 init.lua:138
msgid "Terrarium Base Stone"
msgstr "Základný kameň terária"

#: init.lua:134 init.lua:150
msgid "Garden Floor"
msgstr "Podlaha záhrady"

#: init.lua:135
msgid "Solid dark stone foundation underneath the garden soil."
msgstr "Pevný tmavý kamenný základ pod záhradnou pôdou."

#: init.lua:149 init.lua:157
msgid "Garden Soil"
msgstr "Záhradná pôda"

#: init.lua:151
msgid "Soft brown earth covering the floor of every glass room."
msgstr "Mäkká hnedá zemina pokrývajúca podlahu každej sklenenej miestnosti."

#: init.lua:152
msgid "Can be upgraded into glowing green Fertile Soil that speeds up you and your plants!"
msgstr "Dá sa vylepšiť na žiariacu zelenú Úrodnú pôdu, ktorá zrýchli vás aj vaše rastliny!"

#: init.lua:153
msgid "Clear green Acid Slime with Pestle [4] or splash Chalk with Water Flask [3] on top of this soil."
msgstr "Vyčistite zelený Kyslý sliz Tĺčikom [4] alebo ošpliechajte Kriedu Fľašou s vodou [3] priamo na tejto pôde."

#: init.lua:169
msgid "Rich Green Soil · Speed Boost"
msgstr "Bohatá zelená pôda · Zrýchlenie behu"

#: init.lua:170
msgid "Glowing green soil created whenever you clean up Acid, Chalk, or a Prismatic Geode."
msgstr "Žiariaca zelená pôda, ktorá vznikne pri vyčistení Kyseliny, Kriedy alebo Prizmatickej geódy."

#: init.lua:171
msgid "Helps nearby plants bloom faster AND lets you run much quicker when you walk on it!"
msgstr "Pomáha okolitým rastlinám kvitnúť rýchlejšie A umožní vám oveľa rýchlejšie bežať, keď po nej kráčate!"

#: init.lua:172
msgid "Create green paths from room to room so you can dash across your garden with ease."
msgstr "Vytvárajte zelené chodníky z miestnosti do miestnosti, aby ste sa mohli záhradou preháňať s ľahkosťou."

#: init.lua:175
msgid "Fertile Soil (Faster Running & Plant Growth)"
msgstr "Úrodná pôda (Rýchlejší beh a rast rastlín)"

#: init.lua:204 init.lua:215
msgid "Garden Tip"
msgstr "Záhradný tip"

#: init.lua:205
msgid "Blocks can only be placed down on the garden floor!"
msgstr "Bloky možno položiť iba na podlahu záhrady!"

#: init.lua:216
msgid "Please leave a little room around your plants!"
msgstr "Nechajte, prosím, okolo svojich rastlín trochu miesta!"

#: init.lua:316
msgid "Hot Block · Raises Heat"
msgstr "Horúci blok · Zvyšuje teplo"

#: init.lua:327
msgid "Cold Block · Lowers Heat"
msgstr "Studený blok · Znižuje teplo"

#: init.lua:338
msgid "Sour Puddle · Sours Soil"
msgstr "Kyslá mláka · Okysľuje pôdu"

#: init.lua:358
msgid "Dry Block · Dries Soil"
msgstr "Suchý blok · Vysušuje pôdu"

#: init.lua:411
msgid "Bonus Crystal · Level 2+"
msgstr "Bonusový kryštál · Úroveň 2+"

#: init.lua:431
msgid "Cracks into 2 hazards in 22s!"
msgstr "Praskne na 2 hrozby o 22s!"

#: init.lua:432 init.lua:484
msgid "Left-Click or Right-Click with Trowel [1] to clear nearby hazards!"
msgstr "Kliknite ľavým alebo pravým tlačidlom s Lopatkou [1] na vyčistenie okolitých hrozieb!"

#: init.lua:455
msgid "Switch to your Trowel [1] and Left-Click or Right-Click this Prismatic Geode to crack it open!"
msgstr "Prepnite na Lopatku [1] a kliknite ľavým alebo pravým tlačidlom na túto Prizmatickú geódu, aby ste ju rozbili!"

#: init.lua:468
msgid "Switch to your Trowel [1] (or place any block beside this Geode) to crack it open!"
msgstr "Prepnite na Lopatku [1] (alebo položte vedľa tejto Geódy akýkoľvek blok), aby ste ju rozbili!"

#: init.lua:483
msgid "Cracks into 2 hazards in @1s!"
msgstr "Praskne na 2 hrozby o @1s!"

#: init.lua:508
msgid "Crystal Cracked"
msgstr "Kryštál praskol"

#: init.lua:509
msgid "An unopened Prismatic Geode cracked apart into 2 hazard blocks!"
msgstr "Neotvorená Prizmatická geóda sa rozpadla na 2 nebezpečné bloky!"

#: init.lua:522
msgid "Fresh Water"
msgstr "Čistá voda"

#: init.lua:523 init.lua:565
msgid "Refills Your Water Flask"
msgstr "Dopĺňa vašu Fľašu s vodou"

#: init.lua:524
msgid "Clean, cool water left behind whenever you melt blue Ice Shards."
msgstr "Čistá chladná voda, ktorá zostane po roztopení modrých Ľadovcových črepov."

#: init.lua:525
msgid "Gently cools the room and washes away nearby Brimstone or Chalk."
msgstr "Jemne ochladzuje miestnosť a zmýva okolitú Síru alebo Kriedu."

#: init.lua:526
msgid "Left-Click this water with your Water Flask [3] to scoop up the puddle and fill 3 splashes!"
msgstr "Kliknite ľavým tlačidlom na túto vodu Fľašou s vodou [3], naberte mláku a získajte 3 šplechnutia!"

#: init.lua:529
msgid "Fresh Water (Left-Click with Flask [3])"
msgstr "Čistá voda (Ľavý klik Fľašou [3])"

#: init.lua:564 init.lua:571
msgid "Flowing Water"
msgstr "Tečúca voda"

#: init.lua:566
msgid "Spreading ripples of cool water."
msgstr "Šíriace sa vlnky chladnej vody."

#: init.lua:567
msgid "Melts Chalk on contact and cools hot Brimstone into Steam."
msgstr "Pri kontakte rozpúšťa Kriedu a ochladzuje horúcu Síru na Paru."

#: init.lua:568
msgid "Left-Click anywhere on the puddle with your Water Flask [3] to scoop it up and refill!"
msgstr "Kliknite ľavým tlačidlom kamkoľvek na mláku Fľašou s vodou [3], aby ste ju nabrali a doplnili fľašu!"

#: init.lua:602
msgid "Rising Steam"
msgstr "Stúpajúca para"

#: init.lua:603
msgid "Warm Mist · High Jump"
msgstr "Teplá hmla · Vysoký skok"

#: init.lua:604
msgid "Soft, warm mist created when water cools down hot Brimstone or Ice melts."
msgstr "Jemná teplá hmla vytvorená, keď voda ochladí horúcu Síru alebo sa roztopí Ľad."

#: init.lua:605
msgid "Step through it to float lightly and jump much higher for 5 seconds!"
msgstr "Prejdite cez ňu, aby ste sa ľahko vznášali a skákali oveľa vyššie po dobu 5 sekúnd!"

#: init.lua:606
msgid "Walk into rising steam to leap high, or Left-Click it with your Water Flask [3] to refill."
msgstr "Vstúpte do stúpajúcej pary pre vysoký skok, alebo na ňu kliknite ľavým tlačidlom Fľašou s vodou [3] na doplnenie."

#: init.lua:609
msgid "Rising Steam (Walk In for High Jump)"
msgstr "Stúpajúca para (Vstúpte pre vysoký skok)"

#: init.lua:642
msgid "Magical Plant · Protect & Grow!"
msgstr "Čarovná rastlina · Chráňte a pestujte!"

#: init.lua:643
msgid "The living heart of each glass room—grow all plants to 100% Bloom to finish the level!"
msgstr "Živé srdce každej sklenenej miestnosti — vypestujte všetky rastliny na 100% Rozkvet pre dokončenie úrovne!"

#: init.lua:644
