#: api.lua:150
msgid "Thermal Bellows [2] — @1/@2 Puffs"
msgstr "Fuelle térmico [2] — @1/@2 Soplos"

#: api.lua:154
msgid "Water Flask [3] — @1/@2 Splashes"
msgstr "Frasco de agua [3] — @1/@2 Chorros"

#: api.lua:158
msgid "Limestone Pestle [4] — @1/@2 Sweeps"
msgstr "Pilón calizo [4] — @1/@2 Barridos"

#: api.lua:343
msgid "Hand-Pumped +1 Puff — Brimstone fills all!"
msgstr "+1 Soplo manual — ¡el Azufre llena todo!"

#: api.lua:356
msgid "Condensed +1 Splash — Water fills all!"
msgstr "+1 Chorro condensado — ¡el Agua llena todo!"

#: api.lua:369
msgid "Scraped +1 Sweep — Chalk fills all!"
msgstr "+1 Barrido raspado — ¡la Tiza llena todo!"

#: api.lua:404 api.lua:480
msgid "its opposite block"
msgstr "su bloque opuesto"

#: api.lua:412
msgid "Trowel [1] — Carrying @1 (Click @2 or Floor)"
msgstr "Paleta [1] — Llevando @1 (Clic en @2 o suelo)"

#: api.lua:415
msgid "Alchemist's Trowel — Carrying @1"
msgstr "Paleta de alquimista — Llevando @1"

#: api.lua:416
msgid "Tool [1] · Holding 1 Block"
msgstr "Herramienta [1] · Llevando 1 bloque"

#: api.lua:417
msgid "Safely holding @1 on your trowel."
msgstr "Sosteniendo @1 de forma segura en tu paleta."

#: api.lua:418
msgid "Combine it with @1 so both cancel out and boost plant growth!"
msgstr "¡Combínalo con @1 para que ambos se anulen e impulsen el crecimiento!"

#: api.lua:419
msgid "Click directly on @1 (or Right-Click empty floor beside it) to combine!"
msgstr "¡Haz clic directo en @1 (o clic derecho en el suelo vacío al lado) para combinar!"

#: api.lua:483
msgid "Carrying @1! Click directly on @2 to combine, or Right-Click an empty floor tile to set it down."
msgstr "¡Llevando @1! Haz clic directo en @2 para combinar, o clic derecho en suelo vacío para soltarlo."

#: api.lua:485
msgid "a block"
msgstr "un bloque"

#: init.lua:72
msgid "Left-Click or Right-Click a hazard block (Brimstone, Ice, Acid, or Chalk) to pick it up onto your Trowel!"
msgstr "¡Clic izquierdo o derecho en un bloque peligroso (Azufre, Hielo, Ácido o Tiza) para recogerlo con tu Paleta!"

#: init.lua:85
msgid "Please leave a little room around your plants!"
msgstr "¡Deja un poco de espacio alrededor de tus plantas!"

#: init.lua:105
msgid "Click directly on the opposite block to combine, or Right-Click an empty spot on the garden floor!"
msgstr "¡Haz clic directo en el bloque opuesto para combinar, o clic derecho en un hueco del suelo!"

#: init.lua:112
msgid "Alchemist's Trowel"
msgstr "Paleta de alquimista"

#: init.lua:113
msgid "Tool [1] · Move & Combine Blocks"
msgstr "Herramienta [1] · Mover y combinar bloques"

#: init.lua:114
msgid "A sturdy gardening trowel that safely picks up hazard blocks and opens bonus crystals."
msgstr "Una resistente paleta de jardín que recoge bloques peligrosos sin daño y abre cristales extra."

#: init.lua:115
msgid "Combine Brimstone + Ice or Acid + Chalk together for big plant growth!"
msgstr "¡Combina Azufre + Hielo o Ácido + Tiza para un gran impulso de crecimiento!"

#: init.lua:116
msgid "Click any hazard block to pick it up, then click directly on its opposite (or Right-Click empty floor beside it)! Also cracks open Prismatic Geodes."
msgstr "¡Haz clic en un bloque peligroso para recogerlo y luego en su opuesto (o clic derecho al lado)! También abre Geodas prismáticas."

#: init.lua:120
msgid "Trowel [1] — Click to Move & Combine Blocks"
msgstr "Paleta [1] — Clic para mover y combinar bloques"

#: init.lua:170
msgid "Brimstone Siphoned → Bellows Full!"
msgstr "Azufre aspirado → ¡Fuelle lleno!"

#: init.lua:190
msgid "Chalk Ground → Pestle Full!"
msgstr "Tiza molida → ¡Pilón lleno!"

#: init.lua:200
msgid "Thermal Bellows (Empty)"
msgstr "Fuelle térmico (Vacío)"

#: init.lua:201
msgid "Tool [2] · Needs Heat Refill"
msgstr "Herramienta [2] · Necesita recarga de calor"

#: init.lua:202
msgid "A cooled leather air-puffer out of warm puffs (holds 4+ Puffs when refilled)."
msgstr "Un fuelle de cuero enfriado sin soplos cálidos (guarda 4+ Soplos al recargarse)."

#: init.lua:203
msgid "Siphons hot Brimstone right off the floor (or mid-air) to refill all Puffs & boost Bloom!"
msgstr "¡Aspira Azufre caliente del suelo (o en el aire) para llenar todos los Soplos e impulsar la Floración!"

#: init.lua:204
msgid "Left-Click hot Brimstone to refill completely, or Left-Click empty air (1.8s) to hand-pump +1 Puff."
msgstr "Clic izquierdo en Azufre caliente para llenar todo, o al aire (1.8s) para inflar +1 Soplo."

#: init.lua:209
msgid "Thermal Bellows [2] — Empty (Click Brimstone or Air)"
msgstr "Fuelle térmico [2] — Vacío (Clic en Azufre o aire)"

#: init.lua:232 init.lua:244
msgid "Bellows empty! Click Brimstone to refill, or click air to pump +1."
msgstr "¡Fuelle vacío! Clic en Azufre para llenar, o al aire para inflar +1."

#: init.lua:253
msgid "Thermal Bellows (Charged)"
msgstr "Fuelle térmico (Cargado)"

#: init.lua:254
msgid "Tool [2] · Melts Ice · Siphons Brimstone"
msgstr "Herramienta [2] · Derrite Hielo · Aspira Azufre"

#: init.lua:255
msgid "Filled with 4 warm Puffs (+1 every 2 levels, +2 with Dragonlung Bellows)."
msgstr "Lleno con 4 Soplos cálidos (+1 cada 2 niveles, +2 con Fuelle dracónico)."

#: init.lua:256
msgid "Melts blue Ice Shards into Water & Steam! Siphons hot Brimstone when below max Puffs."
msgstr "¡Derrite Esquirlas de hielo en Agua y Vapor! Aspira Azufre caliente si no está al máximo."

#: init.lua:257
msgid "Left-Click blue Ice to melt (1 Puff), or Left-Click Brimstone when low to refill all Puffs!"
msgstr "¡Clic izquierdo en Hielo azul para derretir (1 Soplo), o en Azufre cuando baje para llenar todo!"

#: init.lua:260
msgid "Thermal Bellows [2] — 4/4 Puffs"
msgstr "Fuelle térmico [2] — 4/4 Soplos"

#: init.lua:282
msgid "Bellows [2] is full! Splash Brimstone [3] or pair Ice [1]."
msgstr "¡Fuelle [2] lleno! Rocía Azufre [3] o une Hielo [1]."

#: init.lua:340
msgid "Melted Ice → Water!"
msgstr "Hielo derretido → ¡Agua!"

#: init.lua:341
msgid "Melted @1 Ice → Water!"
msgstr "@1 de Hielo derretido → ¡Agua!"

#: init.lua:349
msgid "Puffed Water into rising Steam!"
msgstr "¡Agua soplada en Vapor ascendente!"

#: init.lua:362
msgid "Click Ice to melt, or Brimstone when low to refill!"
msgstr "¡Clic en Hielo para derretir, o en Azufre cuando baje para recargar!"

#: init.lua:445
msgid "Water Flask (Empty)"
msgstr "Frasco de agua (Vacío)"

#: init.lua:446
msgid "Tool [3] · Needs Refill"
msgstr "Herramienta [3] · Necesita recarga"

#: init.lua:447
msgid "A glass watering flask out of cool splashes (holds 3+ Splashes when refilled)."
msgstr "Un frasco de vidrio sin chorros frescos (guarda 3+ Chorros al recargarse)."

#: init.lua:448
msgid "Scoops up an entire Water puddle or Steam cloud to fill your flask all the way!"
msgstr "¡Recoge todo un charco de Agua o nube de Vapor para llenar el frasco al máximo!"

#: init.lua:449
msgid "Left-Click Water/Steam to refill completely, or Left-Click empty air (1.8s) to condense +1 Splash."
msgstr "Clic izquierdo en Agua/Vapor para llenar todo, o al aire (1.8s) para condensar +1 Chorro."

#: init.lua:452
msgid "Water Flask [3] — Empty (Click Water/Steam or Air)"
msgstr "Frasco de agua [3] — Vacío (Clic en Agua/Vapor o aire)"

#: init.lua:476 init.lua:489
msgid "Flask empty! Click Water/Steam to fill, or click air to condense +1."
msgstr "¡Frasco vacío! Clic en Agua/Vapor para llenar, o al aire para condensar +1."

#: init.lua:499
msgid "Water Flask (Filled)"
msgstr "Frasco de agua (Lleno)"

#: init.lua:500
msgid "Tool [3] · Ready to Splash!"
msgstr "Herramienta [3] · ¡Listo para rociar!"

#: init.lua:501
msgid "Filled with 3 cool Splashes (+1 every 2 levels, +2 with Deep Retort)."
msgstr "Lleno con 3 Chorros frescos (+1 cada 2 niveles, +2 con Retorta profunda)."

#: init.lua:502
msgid "Cools hot Brimstone into Steam, washes Chalk into green soil, and heals hurt or wilted plants!"
msgstr "¡Enfría Azufre en Vapor, lava Tiza en tierra verde y cura plantas heridas o marchitas!"

#: init.lua:503
msgid "Left-Click Brimstone, Chalk, or a hurt Plant to splash it (or Left-Click extra Water puddles to tidy them up!)."
msgstr "Clic izquierdo en Azufre, Tiza o una Planta herida para rociar (¡o en charcos de Agua extra para recogerlos!)."

#: init.lua:507
msgid "Water Flask [3] — 3/3 Splashes"
msgstr "Frasco de agua [3] — 3/3 Chorros"

#: init.lua:535
msgid "Quenched Brimstone → Steam!"
msgstr "Azufre apagado → ¡Vapor!"

#: init.lua:552
msgid "Washed Chalk → Speed Soil!"
msgstr "Tiza lavada → ¡Tierra veloz!"

#: init.lua:552
msgid "Washed Chalk!"
msgstr "¡Tiza lavada!"

#: init.lua:566
msgid "This plant is already happy and at full 100% health!"
msgstr "¡Esta planta ya está feliz y al 100% de salud!"

#: init.lua:576
msgid "Click Brimstone, Chalk, or a hurt Plant to splash (or click Water to scoop)!"
msgstr "¡Clic en Azufre, Tiza o Planta herida para rociar (o en Agua para recoger)!"

#: init.lua:587
msgid "Limestone Pestle (Empty)"
msgstr "Pilón calizo (Vacío)"

#: init.lua:588
msgid "Tool [4] · Needs Chalk Refill"
msgstr "Herramienta [4] · Necesita recarga de Tiza"

#: init.lua:589
msgid "A bare stone pestle out of mineral powder (holds 4+ Sweeps when refilled)."
msgstr "Un pilón de piedra sin polvo mineral (guarda 4+ Barridos al recargarse)."

#: init.lua:590
msgid "Grinds dry Alkaline Chalk right off the floor (or mid-air) into Speed Soil & refills all Sweeps!"
msgstr "¡Muele Tiza alcalina del suelo (o en el aire) en Tierra veloz y recarga todos los Barridos!"

#: init.lua:591
msgid "Left-Click Alkaline Chalk to refill completely, or Left-Click empty air (1.8s) to scrape +1 Sweep."
msgstr "Clic izquierdo en Tiza alcalina para llenar todo, o al aire (1.8s) para raspar +1 Barrido."

#: init.lua:594
msgid "Limestone Pestle [4] — Empty (Click Chalk or Air)"
msgstr "Pilón calizo [4] — Vacío (Clic en Tiza o aire)"

#: init.lua:614 init.lua:626
msgid "Pestle empty! Click Chalk to refill, or click air to scrape +1."
msgstr "¡Pilón vacío! Clic en Tiza para llenar, o al aire para raspar +1."

#: init.lua:635
msgid "Limestone Pestle (Charged)"
msgstr "Pilón calizo (Cargado)"

#: init.lua:636
msgid "Tool [4] · Clears Acid · Grinds Chalk"
msgstr "Herramienta [4] · Limpia Ácido · Muele Tiza"

#: init.lua:637
msgid "Coated with 4 mineral Sweeps (+1 every 2 levels, +2 with Starlight Mortar)."
msgstr "Cubierto con 4 Barridos minerales (+1 cada 2 niveles, +2 con Mortero estelar)."

#: init.lua:638
msgid "Clears a wide patch of green Acid Slime into Speed Soil! Grinds Chalk when below max Sweeps."
msgstr "¡Convierte una zona amplia de Lodo ácido en Tierra veloz! Muele Tiza si no está al máximo."

#: init.lua:639
msgid "Left-Click on or near Acid Slime (1 Sweep), or Left-Click Chalk when low to refill all Sweeps!"
msgstr "¡Clic izquierdo sobre o cerca de Lodo ácido (1 Barrido), o en Tiza cuando baje para llenar todo!"

#: init.lua:642
msgid "Limestone Pestle [4] — 4/4 Sweeps"
msgstr "Pilón calizo [4] — 4/4 Barridos"

#: init.lua:663
msgid "Pestle [4] is full! Wash Chalk [3] or pair Acid [1]."
msgstr "¡Pilón [4] lleno! Lava Tiza [3] o une Ácido [1]."

#: init.lua:698
msgid "Cleared Acid → Speed Soil!"
msgstr "Ácido limpiado → ¡Tierra veloz!"

#: init.lua:699
msgid "Cleared @1 Acid → Speed Soil!"
msgstr "@1 de Ácido limpiado → ¡Tierra veloz!"

#: init.lua:710
msgid "Click near Acid Slime, or Chalk when low to refill!"
msgstr "¡Clic cerca de Lodo ácido, o en Tiza cuando baje para recargar!"

#: init.lua:727
msgid "Gardener's Guidebook"
msgstr "Guía del jardinero"

#: init.lua:728
msgid "Tool [5] · Illustrated How-to-Play"
msgstr "Herramienta [5] · Guía ilustrada"

#: init.lua:729
msgid "Your friendly picture guide to every block, tool, potion, plant tip, and Top 10 score."
msgstr "Tu guía ilustrada de cada bloque, herramienta, poción, consejo de cultivo y Top 10."

#: init.lua:730
msgid "Shows clear tips with hoverable item pictures—plus the Top 10 Leaderboard!"
msgstr "Muestra consejos claros con iconos interactivos, ¡además de la tabla del Top 10!"

#: init.lua:731
msgid "Left-Click or Right-Click anytime to read (press [Z] to call out a room; hold [E]+W to sprint!)."
msgstr "Clic izquierdo o derecho cuando quieras para leer (pulsa [Z] para marcar sala; ¡mantén [E]+W para esprintar!)."

#: init.lua:735
msgid "Guidebook [5] — How to Play & Top 10"
msgstr "Guía [5] — Cómo jugar y Top 10"

#: init.lua:826
msgid "Aegis Potion"
msgstr "Poción Égida"

#: init.lua:827
msgid "Aegis Potion — Full Heal & Garden Shield (12s)"
msgstr "Poción Égida — Curación total y Escudo (12s)"

#: init.lua:828
msgid "Lifesaver Potion · From Geodes & Level Clears"
msgstr "Poción salvavidas · De Geodas y niveles"

#: init.lua:829
msgid "A rare golden-green elixir that heals you and shields both you and your whole garden."
msgstr "Un raro elixir verde dorado que te cura y os protege a ti y a todo tu jardín."

#: init.lua:830
msgid "Refills your full health, revives all wilted plants, & shields you + every plant for 12s (14s with Sunlit Dew)! Also triggers automatically if you run out of health!"
msgstr "¡Restaura toda tu salud, revive plantas marchitas y os protege a ti y a las plantas por 12s (14s con Rocío solar)! ¡Se activa sola si te quedas sin salud!"

#: init.lua:832
msgid "Left-Click or Right-Click to drink—or keep one in your bag as an automatic lifesaver!"
msgstr "¡Clic izquierdo o derecho para beberla, o guárdala en tu bolsa como salvavidas automático!"

#: init.lua:847
msgid "Chronos Hourglass"
msgstr "Reloj de Cronos"

#: init.lua:848
msgid "Chronos Hourglass — Pause Falling Blocks (12s)"
msgstr "Reloj de Cronos — Pausa caídas (12s)"

#: init.lua:849
msgid "Time Hourglass · Earned Every Level Cleared"
msgstr "Reloj temporal · Ganado al superar cada nivel"

#: init.lua:850
msgid "A magical brass hourglass filled with sparkling violet sand."
msgstr "Un reloj de arena mágico de latón lleno de brillante arena violeta."

#: init.lua:851
msgid "Pauses new falling blocks for 12 seconds, clears 1 nearby hazard per plant, & speeds up the team!"
msgstr "¡Pausa la caída de bloques 12 segundos, limpia 1 peligro cercano por planta y acelera al equipo!"

#: init.lua:852
msgid "Left-Click or Right-Click whenever your rooms get busy and you need breathing room!"
msgstr "¡Clic izquierdo o derecho cuando tus salas se llenen y necesites un respiro!"

