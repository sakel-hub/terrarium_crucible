#: api.lua:150
msgid "Thermal Bellows [2] — @1/@2 Puffs"
msgstr "Fole Térmico [2] — @1/@2 Sopros"

#: api.lua:154
msgid "Water Flask [3] — @1/@2 Splashes"
msgstr "Frasco d'Água [3] — @1/@2 Borrifos"

#: api.lua:158
msgid "Limestone Pestle [4] — @1/@2 Sweeps"
msgstr "Pilão Calcário [4] — @1/@2 Varridas"

#: api.lua:343
msgid "Hand-Pumped +1 Puff — Brimstone fills all!"
msgstr "+1 Sopro manual — Enxofre enche tudo!"

#: api.lua:356
msgid "Condensed +1 Splash — Water fills all!"
msgstr "+1 Borrifo condensado — Água enche tudo!"

#: api.lua:369
msgid "Scraped +1 Sweep — Chalk fills all!"
msgstr "+1 Varrida raspada — Giz enche tudo!"

#: api.lua:404 api.lua:480
msgid "its opposite block"
msgstr "seu bloco oposto"

#: api.lua:412
msgid "Trowel [1] — Carrying @1 (Click @2 or Floor)"
msgstr "Pá [1] — Levando @1 (Clique em @2 ou Chão)"

#: api.lua:415
msgid "Alchemist's Trowel — Carrying @1"
msgstr "Pá do Alquimista — Levando @1"

#: api.lua:416
msgid "Tool [1] · Holding 1 Block"
msgstr "Ferramenta [1] · Segurando 1 Bloco"

#: api.lua:417
msgid "Safely holding @1 on your trowel."
msgstr "Segurando @1 com segurança na sua pá."

#: api.lua:418
msgid "Combine it with @1 so both cancel out and boost plant growth!"
msgstr "Combine com @1 para anular ambos e impulsionar o crescimento!"

#: api.lua:419
msgid "Click directly on @1 (or Right-Click empty floor beside it) to combine!"
msgstr "Clique direto em @1 (ou clique direito no chão vazio ao lado) para combinar!"

#: api.lua:483
msgid "Carrying @1! Click directly on @2 to combine, or Right-Click an empty floor tile to set it down."
msgstr "Levando @1! Clique direto em @2 para combinar, ou clique direito no chão vazio para soltar."

#: api.lua:485
msgid "a block"
msgstr "um bloco"

#: init.lua:72
msgid "Left-Click or Right-Click a hazard block (Brimstone, Ice, Acid, or Chalk) to pick it up onto your Trowel!"
msgstr "Clique esq. ou dir. num bloco de perigo (Enxofre, Gelo, Ácido ou Giz) para pegá-lo com sua Pá!"

#: init.lua:85
msgid "Please leave a little room around your plants!"
msgstr "Deixe um pouco de espaço ao redor das suas plantas!"

#: init.lua:105
msgid "Click directly on the opposite block to combine, or Right-Click an empty spot on the garden floor!"
msgstr "Clique direto no bloco oposto para combinar, ou clique direito num espaço vazio do chão!"

#: init.lua:112
msgid "Alchemist's Trowel"
msgstr "Pá do Alquimista"

#: init.lua:113
msgid "Tool [1] · Move & Combine Blocks"
msgstr "Ferramenta [1] · Mover e Combinar Blocos"

#: init.lua:114
msgid "A sturdy gardening trowel that safely picks up hazard blocks and opens bonus crystals."
msgstr "Uma pá de jardinagem firme que pega blocos perigosos sem dano e abre cristais bônus."

#: init.lua:115
msgid "Combine Brimstone + Ice or Acid + Chalk together for big plant growth!"
msgstr "Combine Enxofre + Gelo ou Ácido + Giz para um grande salto de crescimento!"

#: init.lua:116
msgid "Click any hazard block to pick it up, then click directly on its opposite (or Right-Click empty floor beside it)! Also cracks open Prismatic Geodes."
msgstr "Clique em qualquer bloco perigoso para pegar e clique no oposto (ou botão direito ao lado)! Também abre Geodos Prismáticos."

#: init.lua:120
msgid "Trowel [1] — Click to Move & Combine Blocks"
msgstr "Pá [1] — Clique para Mover e Combinar Blocos"

#: init.lua:170
msgid "Brimstone Siphoned → Bellows Full!"
msgstr "Enxofre Sugado → Fole Cheio!"

#: init.lua:190
msgid "Chalk Ground → Pestle Full!"
msgstr "Giz Moído → Pilão Cheio!"

#: init.lua:200
msgid "Thermal Bellows (Empty)"
msgstr "Fole Térmico (Vazio)"

#: init.lua:201
msgid "Tool [2] · Needs Heat Refill"
msgstr "Ferramenta [2] · Precisa de Calor"

#: init.lua:202
msgid "A cooled leather air-puffer out of warm puffs (holds 4+ Puffs when refilled)."
msgstr "Um fole de couro resfriado sem sopros quentes (guarda 4+ Sopros quando cheio)."

#: init.lua:203
msgid "Siphons hot Brimstone right off the floor (or mid-air) to refill all Puffs & boost Bloom!"
msgstr "Suga Enxofre quente do chão (ou no ar) para encher todos os Sopros e dar Floração!"

#: init.lua:204
msgid "Left-Click hot Brimstone to refill completely, or Left-Click empty air (1.8s) to hand-pump +1 Puff."
msgstr "Clique esquerdo no Enxofre quente para encher tudo, ou no ar (1.8s) para bombear +1 Sopro."

#: init.lua:209
msgid "Thermal Bellows [2] — Empty (Click Brimstone or Air)"
msgstr "Fole Térmico [2] — Vazio (Clique Enxofre ou Ar)"

#: init.lua:232 init.lua:244
msgid "Bellows empty! Click Brimstone to refill, or click air to pump +1."
msgstr "Fole vazio! Clique em Enxofre para encher, ou no ar para bombear +1."

#: init.lua:253
msgid "Thermal Bellows (Charged)"
msgstr "Fole Térmico (Carregado)"

#: init.lua:254
msgid "Tool [2] · Melts Ice · Siphons Brimstone"
msgstr "Ferramenta [2] · Derrete Gelo · Suga Enxofre"

#: init.lua:255
msgid "Filled with 4 warm Puffs (+1 every 2 levels, +2 with Dragonlung Bellows)."
msgstr "Cheio com 4 Sopros quentes (+1 a cada 2 níveis, +2 com Fole Dracônico)."

#: init.lua:256
msgid "Melts blue Ice Shards into Water & Steam! Siphons hot Brimstone when below max Puffs."
msgstr "Derrete Lascas de Gelo em Água e Vapor! Suga Enxofre quente quando abaixo do máximo."

#: init.lua:257
msgid "Left-Click blue Ice to melt (1 Puff), or Left-Click Brimstone when low to refill all Puffs!"
msgstr "Clique esquerdo no Gelo azul para derreter (1 Sopro), ou no Enxofre quando baixo para encher tudo!"

#: init.lua:260
msgid "Thermal Bellows [2] — 4/4 Puffs"
msgstr "Fole Térmico [2] — 4/4 Sopros"

#: init.lua:282
msgid "Bellows [2] is full! Splash Brimstone [3] or pair Ice [1]."
msgstr "Fole [2] cheio! Borrife Enxofre [3] ou una Gelo [1]."

#: init.lua:340
msgid "Melted Ice → Water!"
msgstr "Gelo Derretido → Água!"

#: init.lua:341
msgid "Melted @1 Ice → Water!"
msgstr "@1 Gelo Derretido → Água!"

#: init.lua:349
msgid "Puffed Water into rising Steam!"
msgstr "Soprou Água em Vapor Ascendente!"

#: init.lua:362
msgid "Click Ice to melt, or Brimstone when low to refill!"
msgstr "Clique no Gelo para derreter, ou Enxofre quando baixo para encher!"

#: init.lua:445
msgid "Water Flask (Empty)"
msgstr "Frasco d'Água (Vazio)"

#: init.lua:446
msgid "Tool [3] · Needs Refill"
msgstr "Ferramenta [3] · Precisa Recarregar"

#: init.lua:447
msgid "A glass watering flask out of cool splashes (holds 3+ Splashes when refilled)."
msgstr "Um frasco de vidro sem borrifos frescos (guarda 3+ Borrifos quando cheio)."

#: init.lua:448
msgid "Scoops up an entire Water puddle or Steam cloud to fill your flask all the way!"
msgstr "Recolhe uma poça inteira de Água ou nuvem de Vapor para encher o frasco até o topo!"

#: init.lua:449
msgid "Left-Click Water/Steam to refill completely, or Left-Click empty air (1.8s) to condense +1 Splash."
msgstr "Clique esquerdo em Água/Vapor para encher tudo, ou no ar (1.8s) para condensar +1 Borrifo."

#: init.lua:452
msgid "Water Flask [3] — Empty (Click Water/Steam or Air)"
msgstr "Frasco d'Água [3] — Vazio (Clique Água/Vapor ou Ar)"

#: init.lua:476 init.lua:489
msgid "Flask empty! Click Water/Steam to fill, or click air to condense +1."
msgstr "Frasco vazio! Clique em Água/Vapor para encher, ou no ar para condensar +1."

#: init.lua:499
msgid "Water Flask (Filled)"
msgstr "Frasco d'Água (Cheio)"

#: init.lua:500
msgid "Tool [3] · Ready to Splash!"
msgstr "Ferramenta [3] · Pronto para Borrifar!"

#: init.lua:501
msgid "Filled with 3 cool Splashes (+1 every 2 levels, +2 with Deep Retort)."
msgstr "Cheio com 3 Borrifos frescos (+1 a cada 2 níveis, +2 com Retorta Profunda)."

#: init.lua:502
msgid "Cools hot Brimstone into Steam, washes Chalk into green soil, and heals hurt or wilted plants!"
msgstr "Esfria Enxofre em Vapor, lava Giz em solo verde e cura plantas feridas ou murchas!"

#: init.lua:503
msgid "Left-Click Brimstone, Chalk, or a hurt Plant to splash it (or Left-Click extra Water puddles to tidy them up!)."
msgstr "Clique esquerdo em Enxofre, Giz ou Planta ferida para borrifar (ou em poças d'Água extras para recolher!)."

#: init.lua:507
msgid "Water Flask [3] — 3/3 Splashes"
msgstr "Frasco d'Água [3] — 3/3 Borrifos"

#: init.lua:535
msgid "Quenched Brimstone → Steam!"
msgstr "Enxofre Apagado → Vapor!"

#: init.lua:552
msgid "Washed Chalk → Speed Soil!"
msgstr "Giz Lavado → Solo Veloz!"

#: init.lua:552
msgid "Washed Chalk!"
msgstr "Giz Lavado!"

#: init.lua:566
msgid "This plant is already happy and at full 100% health!"
msgstr "Esta planta já está feliz e com 100% de saúde!"

#: init.lua:576
msgid "Click Brimstone, Chalk, or a hurt Plant to splash (or click Water to scoop)!"
msgstr "Clique em Enxofre, Giz ou Planta ferida para borrifar (ou Água para recolher)!"

#: init.lua:587
msgid "Limestone Pestle (Empty)"
msgstr "Pilão Calcário (Vazio)"

#: init.lua:588
msgid "Tool [4] · Needs Chalk Refill"
msgstr "Ferramenta [4] · Precisa de Giz"

#: init.lua:589
msgid "A bare stone pestle out of mineral powder (holds 4+ Sweeps when refilled)."
msgstr "Um pilão de pedra sem pó mineral (guarda 4+ Varridas quando cheio)."

#: init.lua:590
msgid "Grinds dry Alkaline Chalk right off the floor (or mid-air) into Speed Soil & refills all Sweeps!"
msgstr "Mói Giz Alcalino direto do chão (ou no ar) em Solo Veloz e recarrega todas as Varridas!"

#: init.lua:591
msgid "Left-Click Alkaline Chalk to refill completely, or Left-Click empty air (1.8s) to scrape +1 Sweep."
msgstr "Clique esquerdo no Giz Alcalino para encher tudo, ou no ar (1.8s) para raspar +1 Varrida."

#: init.lua:594
msgid "Limestone Pestle [4] — Empty (Click Chalk or Air)"
msgstr "Pilão Calcário [4] — Vazio (Clique Giz ou Ar)"

#: init.lua:614 init.lua:626
msgid "Pestle empty! Click Chalk to refill, or click air to scrape +1."
msgstr "Pilão vazio! Clique em Giz para encher, ou no ar para raspar +1."

#: init.lua:635
msgid "Limestone Pestle (Charged)"
msgstr "Pilão Calcário (Carregado)"

#: init.lua:636
msgid "Tool [4] · Clears Acid · Grinds Chalk"
msgstr "Ferramenta [4] · Limpa Ácido · Mói Giz"

#: init.lua:637
msgid "Coated with 4 mineral Sweeps (+1 every 2 levels, +2 with Starlight Mortar)."
msgstr "Coberto com 4 Varridas minerais (+1 a cada 2 níveis, +2 com Almofariz Estelar)."

#: init.lua:638
msgid "Clears a wide patch of green Acid Slime into Speed Soil! Grinds Chalk when below max Sweeps."
msgstr "Transforma uma grande área de Limo Ácido em Solo Veloz! Mói Giz quando abaixo do máximo."

#: init.lua:639
msgid "Left-Click on or near Acid Slime (1 Sweep), or Left-Click Chalk when low to refill all Sweeps!"
msgstr "Clique esquerdo sobre ou perto de Limo Ácido (1 Varrida), ou no Giz quando baixo para encher tudo!"

#: init.lua:642
msgid "Limestone Pestle [4] — 4/4 Sweeps"
msgstr "Pilão Calcário [4] — 4/4 Varridas"

#: init.lua:663
msgid "Pestle [4] is full! Wash Chalk [3] or pair Acid [1]."
msgstr "Pilão [4] cheio! Lave Giz [3] ou una Ácido [1]."

#: init.lua:698
msgid "Cleared Acid → Speed Soil!"
msgstr "Ácido Limpo → Solo Veloz!"

#: init.lua:699
msgid "Cleared @1 Acid → Speed Soil!"
msgstr "@1 Ácido Limpo → Solo Veloz!"

#: init.lua:710
msgid "Click near Acid Slime, or Chalk when low to refill!"
msgstr "Clique perto do Limo Ácido, ou no Giz quando baixo para encher!"

#: init.lua:727
msgid "Gardener's Guidebook"
msgstr "Guia do Jardineiro"

#: init.lua:728
msgid "Tool [5] · Illustrated How-to-Play"
msgstr "Ferramenta [5] · Guia Ilustrado"

#: init.lua:729
msgid "Your friendly picture guide to every block, tool, potion, plant tip, and Top 10 score."
msgstr "Seu guia ilustrado sobre cada bloco, ferramenta, poção, dica de cultivo e Top 10."

#: init.lua:730
msgid "Shows clear tips with hoverable item pictures—plus the Top 10 Leaderboard!"
msgstr "Mostra dicas claras com ícones interativos — além do placar Top 10!"

#: init.lua:731
msgid "Left-Click or Right-Click anytime to read (press [Z] to call out a room; hold [E]+W to sprint!)."
msgstr "Clique esq. ou dir. quando quiser para ler (aperte [Z] para marcar sala; segure [E]+W para correr!)."

#: init.lua:735
msgid "Guidebook [5] — How to Play & Top 10"
msgstr "Guia [5] — Como Jogar e Top 10"

#: init.lua:826
msgid "Aegis Potion"
msgstr "Poção Égide"

#: init.lua:827
msgid "Aegis Potion — Full Heal & Garden Shield (12s)"
msgstr "Poção Égide — Cura Total e Escudo (12s)"

#: init.lua:828
msgid "Lifesaver Potion · From Geodes & Level Clears"
msgstr "Poção Salva-vidas · De Geodos e Níveis"

#: init.lua:829
msgid "A rare golden-green elixir that heals you and shields both you and your whole garden."
msgstr "Um raro elixir verde-dourado que cura você e protege você e todo o seu jardim."

#: init.lua:830
msgid "Refills your full health, revives all wilted plants, & shields you + every plant for 12s (14s with Sunlit Dew)! Also triggers automatically if you run out of health!"
msgstr "Restaura toda a sua vida, revive plantas murchas e protege você + plantas por 12s (14s com Orvalho Solar)! Também ativa sozinha se sua vida zerar!"

#: init.lua:832
msgid "Left-Click or Right-Click to drink—or keep one in your bag as an automatic lifesaver!"
msgstr "Clique esq. ou dir. para beber — ou guarde na bolsa como salva-vidas automático!"

#: init.lua:847
msgid "Chronos Hourglass"
msgstr "Ampulheta de Cronos"

#: init.lua:848
msgid "Chronos Hourglass — Pause Falling Blocks (12s)"
msgstr "Ampulheta de Cronos — Pausa Quedas (12s)"

#: init.lua:849
msgid "Time Hourglass · Earned Every Level Cleared"
msgstr "Ampulheta do Tempo · Ganha a Cada Nível"

#: init.lua:850
msgid "A magical brass hourglass filled with sparkling violet sand."
msgstr "Uma ampulheta mágica de latão cheia de areia violeta cintilante."

#: init.lua:851
msgid "Pauses new falling blocks for 12 seconds, clears 1 nearby hazard per plant, & speeds up the team!"
msgstr "Pausa novos blocos por 12 segundos, limpa 1 perigo próximo por planta e acelera a equipe!"

#: init.lua:852
msgid "Left-Click or Right-Click whenever your rooms get busy and you need breathing room!"
msgstr "Clique esq. ou dir. sempre que as salas lotarem e você precisar de fôlego!"

