msgstr "Poção Égide [6]"

#: ui.lua:186
msgid "(Geodes & Level Clears · Cap 2)"
msgstr "(Geodos e Níveis · Máx. 2)"

#: ui.lua:189
msgid "Refills full health, revives all wilted plants, & shields you + plants for 12s (triggers automatically if you run out of health!)."
msgstr "Restaura toda a vida, revive plantas murchas e protege você + plantas por 12s (ativa sozinha se sua vida acabar!)."

#: ui.lua:195
msgid "Chronos Hourglass [7]"
msgstr "Ampulheta de Cronos [7]"

#: ui.lua:196
msgid "(Every Level · Cap 2)"
msgstr "(Cada Nível · Máx. 2)"

#: ui.lua:199
msgid "Pauses falling blocks for 12s, clears nearby hazards, & speeds up everyone!"
msgstr "Pausa a queda de blocos por 12s, limpa perigos próximos e acelera todo mundo!"

