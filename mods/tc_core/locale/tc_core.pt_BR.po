msgstr "Geodos Prismáticos e Impulso Final de 85%"

#: ui.lua:158
msgid "Click with Trowel [1] within 22s to clear nearby hazards & refill all Tools [2–4]!"
msgstr "Clique com a Pá [1] em 22s para limpar perigos próximos e recarregar Ferramentas [2–4]!"

