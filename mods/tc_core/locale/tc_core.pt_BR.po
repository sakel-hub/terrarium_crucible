msgid "✦ HELPFUL COMBOS & BONUS CRYSTALS"
msgstr "✦ COMBOS ÚTEIS E CRISTAIS BÔNUS"

#: ui.lua:137
msgid "Combine Hot + Cold with Trowel [1]"
msgstr "Combine Quente + Frio com a Pá [1]"

