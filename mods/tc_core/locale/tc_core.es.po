#: ui.lua:856
msgid "Look Around"
msgstr "Mirar alrededor"

#: ui.lua:857
msgid "Close this window to look around (right-click any Plant to start again)."
msgstr "Cierra esta ventana para mirar alrededor (clic derecho en cualquier Planta para empezar de nuevo)."

#: ui.lua:864
msgid "✖ GARDEN RUN ENDED ON LEVEL @1 ✖"
msgstr "✖ PARTIDA TERMINADA EN EL NIVEL @1 ✖"

#: ui.lua:867
msgid "No worries — right-click any Plant or press [I] to switch to Casual pace anytime!"
msgstr "No pasa nada: ¡haz clic derecho en cualquier Planta o pulsa [I] para cambiar al ritmo Casual cuando quieras!"

