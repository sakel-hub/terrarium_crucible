msgid "✦ YOUR GOAL: GROW EVERY PLANT TO 100% BLOOM"
msgstr "✦ DEIN ZIEL: JEDE PFLANZE AUF 100% BLÜTE BRINGEN"

#: ui.lua:57
msgid "Level 1 starts in 1 cozy glass room with charged Tools [2–4] (4 Puffs · 3 Splashes · 4 Sweeps, gaining +1 cap every 2 levels!)."
msgstr "Level 1 startet in 1 Glasraum mit geladenen Werkzeugen [2–4] (4 Stöße · 3 Spritzer · 4 Schwünge, +1 Kapazität alle 2 Level!)."

#: ui.lua:64
msgid "Reach 100% Bloom with all plants awake to finish the level, pick 1 of 3 Next-Level Blessings, and open a new archway room (plus Level 3+ Trial Waves)!"
msgstr "Erreiche 100% Blüte mit allen wachen Pflanzen, wähle 1 von 3 Segen fürs nächste Level und öffne einen neuen Raum (ab Level 3 mit Prüfungswellen)!"

#: ui.lua:70
msgid "✦ KEEP HEAT & SOIL COMFORTABLE"
msgstr "✦ WÄRME & BODEN IM GLEICHGEWICHT HALTEN"

#: ui.lua:71
msgid "Heat [40°C – 60°C]"
msgstr "Wärme [40°C – 60°C]"

#: ui.lua:72
msgid "Fiery Brimstone makes it hotter; blue Ice makes it colder."
msgstr "Glühender Schwefel heizt auf; blaues Eis kühlt ab."

#: ui.lua:73
msgid "Soil pH [5.6 – 8.4]"
msgstr "Boden-pH [5.6 – 8.4]"

#: ui.lua:74
msgid "Green Acid makes soil too sour; Chalk makes soil too dry."
msgstr "Grüne Säure macht den Boden zu sauer; Kreide macht ihn zu trocken."

#: ui.lua:77
msgid "Keep leftover floor hazards low so the garden stays Balanced — plants heal themselves, wilted plants revive after 6s, and 8s of balance gives everyone a Harmony Boost!"
msgstr "Halte den Boden frei, damit der Garten in Balance bleibt — Pflanzen heilen sich selbst, welke Pflanzen erwachen nach 6s, und 8s Balance verleihen allen einen Harmonie-Boost!"

