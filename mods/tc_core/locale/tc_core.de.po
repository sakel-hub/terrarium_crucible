msgid "✦ SPEED SOIL & RARE ELIXIRS [6–7]"
msgstr "✦ TEMPO-ERDE & SELTENE ELIXIERE [6–7]"

#: ui.lua:175
msgid "Extra potions past your belt cap auto-convert into bonus Bloom & healing!"
msgstr "Überzählige Tränke über dem Gürtellimit werden direkt zu Bonus-Blüte & Heilung!"

#: ui.lua:178
msgid "Fertile Speed Soil"
msgstr "Fruchtbare Tempo-Erde"

#: ui.lua:179
msgid "(Pave Your Own Green Paths!)"
msgstr "(Lege eigene grüne Pfade an!)"

#: ui.lua:182
msgid "Wash Chalk or dust Acid to pave glowing green paths that make you run much faster!"
msgstr "Spüle Kreide ab oder fege Säure weg, um leuchtend grüne Schnelllauf-Pfade zu pflastern!"

#: ui.lua:185
msgid "Aegis Potion [6]"
msgstr "Ägis-Trank [6]"

#: ui.lua:186
msgid "(Geodes & Level Clears · Cap 2)"
msgstr "(Geoden & Levelende · Max. 2)"

#: ui.lua:189
msgid "Refills full health, revives all wilted plants, & shields you + plants for 12s (triggers automatically if you run out of health!)."
msgstr "Heilt voll, belebt alle welken Pflanzen & schützt dich + Pflanzen für 12s (löst bei 0 LP automatisch aus!)."

#: ui.lua:195
msgid "Chronos Hourglass [7]"
msgstr "Chronos-Sanduhr [7]"

#: ui.lua:196
msgid "(Every Level · Cap 2)"
msgstr "(Jedes Level · Max. 2)"

#: ui.lua:199
msgid "Pauses falling blocks for 12s, clears nearby hazards, & speeds up everyone!"
msgstr "Pausiert fallende Blöcke für 12s, beseitigt nahe Gefahren & beschleunigt alle!"

